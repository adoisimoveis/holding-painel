{
  "name": "Painel da Holding",
  "short_name": "Holding",
  "description": "Painel de decisões, carteiras e relatórios da Holding de Agentes.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0F1714",
  "theme_color": "#0F1714",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "icone-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icone.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "imagem",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}